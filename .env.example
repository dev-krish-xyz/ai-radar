# Postgres (local Docker or Neon). Vercel dashboard uses the same Neon URL as GitHub Actions.
DATABASE_URL=postgres://ai_radar:ai_radar@localhost:5433/ai_radar

# Telegram alerts (create a bot via @BotFather, get chat id via @userinfobot)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Used only for semantic classification of ambiguous diffs (LLM_USAGE section of spec)
# Free tier: https://console.groq.com
GROQ_API_KEY=

# Optional but recommended: GitHub classic PAT or fine-grained token.
# - Tags/commits API (5k req/hr) instead of public atom
# - Required for reliable Rising AI repo search (unauth search is 10 req/min and flaky)
# https://github.com/settings/tokens
GITHUB_TOKEN=

# Optional: override default crawl user-agent
CRAWLER_USER_AGENT="ai-radar/0.1 (personal research bot; contact: you@example.com)"
