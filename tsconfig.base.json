{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "declaration": false,
    "noEmit": true,
    "types": ["bun"],
    "baseUrl": ".",
    "paths": {
      "@ai-radar/db": ["packages/db/src/index.ts"],
      "@ai-radar/shared": ["packages/shared/src/index.ts"],
      "@ai-radar/providers": ["packages/providers/src/index.ts"],
      "@ai-radar/crawler": ["packages/crawler/src/index.ts"],
      "@ai-radar/detection": ["packages/detection/src/index.ts"]
    }
  },
  "include": [
    "apps/**/*.ts",
    "apps/**/*.tsx",
    "packages/**/*.ts"
  ],
  "exclude": ["node_modules", "**/node_modules", "**/.next", "apps/web/**"]
}
