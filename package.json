{
  "name": "ai-radar",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "db:generate": "cd packages/db && bun run generate",
    "db:migrate": "cd packages/db && bun run migrate",
    "db:studio": "cd packages/db && bun run studio",
    "db:seed": "bun run apps/worker/src/seed.ts",
    "worker": "bun run apps/worker/src/index.ts",
    "worker:once": "bun run apps/worker/src/index.ts --once",
    "api": "bun run apps/api/src/index.ts",
    "web": "bun run --cwd apps/web dev",
    "up": "bun run scripts/supervise.ts",
    "up:web": "bun run scripts/supervise.ts --web",
    "install:launchd": "bash scripts/install-launchd.sh",
    "typecheck": "tsc -b tsconfig.base.json"
  },
  "devDependencies": {
    "@types/bun": "^1.1.14",
    "typescript": "^5.7.3"
  }
}
